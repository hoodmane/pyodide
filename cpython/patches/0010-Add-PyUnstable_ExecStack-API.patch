From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hood Chatham <roberthoodchatham@gmail.com>
Date: Wed, 21 Oct 2026 12:00:00 +0000
Subject: [PATCH 10/10] Add PyUnstable_ExecStack API for stackful coroutine
 libraries

Squashed from the execstack-3.14 branch of CPython. An execution stack
is the per-coroutine part of a PyThreadState (frame chain and datastack,
exception stack, contextvars context, recursion/tracing depth, ...).
PyUnstable_ExecStack_Suspend()/Resume()/Switch() move that state in and
out of the thread state; Traverse()/Clear() let the owner participate in
GC. Entry frames on the C stack are unlinked while a stack is suspended
so its frames are safe to introspect. Pyodide's stack switching uses
this instead of poking PyThreadState fields.

The Makefile.pre.in and _testcapi hunks are included so the CPython test
suite for the API (Lib/test/test_capi/test_execstack.py, not included)
could be run; the ucontext fiber is only compiled on Linux.
---
diff --git a/Include/cpython/pystate.h b/Include/cpython/pystate.h
index f428396411c..8d015cc4df2 100644
--- a/Include/cpython/pystate.h
+++ b/Include/cpython/pystate.h
@@ -255,6 +255,116 @@ PyAPI_FUNC(int) PyUnstable_ThreadState_SetStackProtection(
 PyAPI_FUNC(void) PyUnstable_ThreadState_ResetStackProtection(
     PyThreadState *tstate);
 
+/* Execution stacks (unstable API).
+
+   An execution stack is the part of a thread state that belongs to one
+   stackful coroutine: the chain of interpreter frames and the memory they
+   live in, the exception-handling stack, the contextvars context, recursion
+   and tracing depth, and a few related bookkeeping fields. Libraries that
+   implement stackful coroutines by switching C stacks (greenlet, Pyodide)
+   use this API to swap that state in and out of a PyThreadState without
+   touching its fields directly.
+
+   Each PyThreadState has exactly one RUNNING execution stack at any time.
+   The thread's original stack (the "root" stack) is created lazily and
+   referenced by the thread state. Every other stack is created with
+   PyUnstable_ExecStack_New().
+
+   The error indicator (tstate->current_exception) is *not* part of an
+   execution stack: it travels with control across a switch, which is how a
+   library throws an exception into a stack. */
+
+// Feature test macro for extensions that support older Pythons too.
+#define Py_HAVE_EXECSTACK 1
+
+typedef struct _PyExecStack PyUnstable_ExecStack;
+
+typedef enum {
+    PyUnstable_ExecStack_NEW = 0,
+    PyUnstable_ExecStack_RUNNING = 1,
+    PyUnstable_ExecStack_SUSPENDED = 2,
+} PyUnstable_ExecStack_State;
+
+// Create a NEW stack with no frames and the given contextvars context
+// (may be NULL). Returns NULL with an exception set on failure.
+PyAPI_FUNC(PyUnstable_ExecStack *) PyUnstable_ExecStack_New(PyObject *context);
+
+// Return a new reference to the stack currently running on tstate, creating
+// the thread's root stack if necessary. Release it with
+// PyUnstable_ExecStack_Free(). Returns NULL with MemoryError on failure.
+//
+// Stacks are reference counted: PyUnstable_ExecStack_New() and this function
+// each hand out one reference, and the thread state holds one reference to
+// its root stack. A root stack whose thread has exited becomes SUSPENDED,
+// empty and detached; it can still be inspected and freed by its remaining
+// owners but can no longer be switched to.
+PyAPI_FUNC(PyUnstable_ExecStack *) PyUnstable_ThreadState_GetExecStack(
+    PyThreadState *tstate);
+
+// Move the per-stack state out of tstate into the running stack and mark it
+// SUSPENDED. Returns that stack (borrowed), or NULL with an exception set and
+// the thread state unchanged. Must be called while attached to tstate and
+// while the C stack of the running stack is still intact: the interpreter
+// reads the frames it keeps on the C stack. Afterwards, until
+// PyUnstable_ExecStack_Resume() is called, no stack is running on tstate; no
+// Python code may run and nothing but the low-level C stack switch itself
+// may happen in between. Does not run Python code.
+PyAPI_FUNC(PyUnstable_ExecStack *) PyUnstable_ExecStack_Suspend(
+    PyThreadState *tstate);
+
+// Install `target` as the running stack of tstate after a Suspend().
+// `target` must be NEW, or SUSPENDED and previously run on tstate. Must be
+// called once the C stack of `target` is in place. Returns -1 with
+// SystemError on misuse; cannot fail otherwise. Does not run Python code.
+PyAPI_FUNC(int) PyUnstable_ExecStack_Resume(
+    PyThreadState *tstate,
+    PyUnstable_ExecStack *target);
+
+// Suspend() followed by Resume(target), for implementations whose outgoing
+// and incoming C stacks are both intact at the same time (e.g. separately
+// allocated stacks). Returns the stack that was running (borrowed), or NULL
+// with an exception set and the thread state unchanged. Switching to the
+// running stack is a no-op.
+PyAPI_FUNC(PyUnstable_ExecStack *) PyUnstable_ExecStack_Switch(
+    PyThreadState *tstate,
+    PyUnstable_ExecStack *target);
+
+PyAPI_FUNC(PyUnstable_ExecStack_State) PyUnstable_ExecStack_GetState(
+    PyUnstable_ExecStack *stack);
+
+// Return a new reference to the topmost complete frame of the stack, or NULL
+// (with the error indicator cleared) if there is none. Same contract as
+// PyThreadState_GetFrame(). Safe to call on a SUSPENDED stack; f_back on the
+// result is also safe.
+PyAPI_FUNC(PyFrameObject *) PyUnstable_ExecStack_GetFrame(
+    PyUnstable_ExecStack *stack);
+
+// Contextvars context of the stack. GetContext returns a new reference or
+// NULL. SetContext accepts NULL or a PyContext. For the RUNNING stack of the
+// current thread these operate on the thread state.
+PyAPI_FUNC(PyObject *) PyUnstable_ExecStack_GetContext(
+    PyUnstable_ExecStack *stack);
+PyAPI_FUNC(int) PyUnstable_ExecStack_SetContext(
+    PyUnstable_ExecStack *stack,
+    PyObject *context);
+
+// For the owner's tp_traverse. Visits the objects owned by a SUSPENDED (or
+// NEW) stack, including the contents of its frames.
+PyAPI_FUNC(int) PyUnstable_ExecStack_Traverse(
+    PyUnstable_ExecStack *stack,
+    visitproc visit,
+    void *arg);
+
+// For the owner's tp_clear. Release everything the stack owns, clearing any
+// suspended frames. The stack remains allocated but can no longer be switched
+// to. Returns -1 with SystemError if the stack is RUNNING.
+PyAPI_FUNC(int) PyUnstable_ExecStack_Clear(PyUnstable_ExecStack *stack);
+
+// Release a reference. When the last reference is dropped the stack is
+// cleared and deallocated. Returns -1 with SystemError if that would
+// deallocate a RUNNING stack.
+PyAPI_FUNC(int) PyUnstable_ExecStack_Free(PyUnstable_ExecStack *stack);
+
 /* Routines for advanced debuggers, requested by David Beazley.
    Don't use unless you know what you are doing! */
 PyAPI_FUNC(PyInterpreterState *) PyInterpreterState_Main(void);
diff --git a/Include/internal/pycore_tstate.h b/Include/internal/pycore_tstate.h
index c3ac52bd766..8ab007f73f2 100644
--- a/Include/internal/pycore_tstate.h
+++ b/Include/internal/pycore_tstate.h
@@ -40,6 +40,12 @@ typedef struct _PyThreadStateImpl {
     PyObject *asyncio_running_loop; // Strong reference
     PyObject *asyncio_running_task; // Strong reference
 
+    // Stackful coroutine support, see Python/execstack.c. `exec_stack` is
+    // the stack currently running on this thread; `root_exec_stack` is the
+    // thread's original stack. Both are NULL until first used.
+    struct _PyExecStack *exec_stack;
+    struct _PyExecStack *root_exec_stack;
+
     /* Head of circular linked-list of all tasks which are instances of `asyncio.Task`
        or subclasses of it used in `asyncio.all_tasks`.
     */
@@ -82,6 +88,10 @@ typedef struct _PyThreadStateImpl {
 
 } _PyThreadStateImpl;
 
+// Release the execution stacks owned by a thread state. Called from
+// PyThreadState_Clear().
+extern void _PyExecStack_ClearThreadState(PyThreadState *tstate);
+
 #ifdef __cplusplus
 }
 #endif
